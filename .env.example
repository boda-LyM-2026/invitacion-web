# =====================================================================
# Copia este archivo a `.env` y completa las credenciales.
#   cp .env.example .env
# =====================================================================

# Supabase (Project Settings -> API en supabase.com)
# Project URL, ejemplo: https://tu-proyecto.supabase.co
VITE_SUPABASE_URL=

# anon public key (SOLO la anon key, nunca la service_role key)
VITE_SUPABASE_ANON_KEY=

# Fecha/hora del evento en ISO con offset. Opcional: por defecto es
# la fecha oficial (2026-11-14T18:00:00-04:00).
VITE_WEDDING_DATETIME=2026-11-14T18:00:00-04:00