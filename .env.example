# Copia este archivo a ".env" y completa con los datos de tu proyecto Supabase.
# Panel Supabase → Project Settings → API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY-PUBLICA

# Fecha y hora del evento (ISO 8601, con zona horaria) usada por el countdown
VITE_WEDDING_DATETIME=2026-11-14T18:00:00-04:00
